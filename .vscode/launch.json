{
    "version": "24.21.0",
    "configurations": [
        
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${file}"
        }
    ],
    "preLaunchTask": "nvs use lts",
    "runtimeArgs": ["lts"],
    "runtimeExecutable": "${env:HOME}/.nvs/nvs"
}