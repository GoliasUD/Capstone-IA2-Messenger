---
config:
    theme: redux-dark-color
---
flowchart LR
    User["Student User"]

    subgraph SYSTEM["Messenger System Boundary"]
        direction LR
        Interface["Client + API / WebSocket Interface"]

        Auth(["1.0 Authenticate<br/>and Manage Sessions"])
        Channels(["2.0 Manage Channels<br/>and Membership"])
        Messages(["3.0 Authorize, Order, Persist<br/>and Route Messages"])
        History(["4.0 Retrieve History"])

        Users[("DS-1 Users and Sessions")]
        Members[("DS-2 Channel Membership")]
        MessageStore[("DS-3 Message Store")]
    end

    User -->|"Register, log in, send DM or channel message"| Interface

    Interface -->|"Credentials"| Auth
    Auth <-->|"Account and session record"| Users
    Auth -->|"Session token"| Interface

    Interface -->|"Create channel, add member"| Channels
    Channels <-->|"Membership record"| Members
    Channels -->|"Membership result"| Interface

    Interface -->|"Message with session token"| Messages
    Messages -->|"Validate token"| Users
    Messages -->|"Channel: verify membership"| Members
    Messages -->|"Persist with sequence and UTC timestamp"| MessageStore
    Messages -->|"Deliver to DM recipient or broadcast to channel members"| Interface

    Interface -->|"History request"| History
    History -->|"Read conversation by sequence"| MessageStore
    History -->|"Ordered message history"| Interface

    Interface -->|"Messages and history"| User

    classDef actor fill:#dbeafe,stroke:#2563eb,color:#0f172a
    classDef interface fill:#e0f2fe,stroke:#0284c7,color:#0f172a
    classDef process fill:#dcfce7,stroke:#16a34a,color:#0f172a
    classDef store fill:#f1f5f9,stroke:#64748b,color:#0f172a
    class User actor
    class Interface interface
    class Auth,Channels,Messages,History process
    class Users,Members,MessageStore store